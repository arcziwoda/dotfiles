[user]
	name = Artur Kempiński
	# GitHub noreply — the repo is public, real addresses stay out of it.
	email = arcziwoda@users.noreply.github.com

# Work identity applies only inside ~/work. The file is NOT tracked in this
# repo (it contains the work address) — create it by hand on a new machine:
#   printf '[user]\n\temail = <work address>\n' > ~/.config/git/config-work
[includeIf "gitdir:~/work/"]
	path = ~/.config/git/config-work

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[include]
	path = ~/.config/git/catppuccin.gitconfig

[delta]
	features = catppuccin-macchiato
	navigate = true          # n / N to jump between files in a diff
	line-numbers = true
	hyperlinks = true

[merge]
	conflictstyle = zdiff3   # shows the common ancestor in conflicts

[diff]
	algorithm = histogram
	colorMoved = default
	# `git dft` opts into difftastic's structural diff for a single command;
	# delta stays the default pager because it handles logs and blame too.
	tool = difftastic

[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

[pager]
	difftool = true

# Strips Claude Code's generated `autoMode` snapshot out of the dotfiles copy
# of settings.json. See .gitattributes there. No smudge counterpart: a checkout
# drops the block and Claude Code regenerates it on the next auto-mode setup.
[filter "strip-claude-state"]
	clean = jq --indent 2 'del(.autoMode)'

[alias]
	dft = -c diff.external=difft diff
	s = status --short --branch
	l = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit

[push]
	default = simple
	autoSetupRemote = true   # `git push` on a new branch just works
	followTags = true

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autosquash = true
	autostash = true

[rerere]
	enabled = true           # remember how you resolved a conflict

[column]
	ui = auto

[branch]
	sort = -committerdate    # most recently used branches first
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
