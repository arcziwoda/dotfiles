#!/usr/bin/env bash
# Session picker: live tmux sessions only, and typing a name that does not
# exist creates it. Single implementation shared by all three entry points:
#
#   - terminal start   .zshrc runs `exec tmux-sessions`, so detaching from tmux
#                      ends the process and closes the window
#   - Alt-s            from inside a shell, no exec
#   - prefix s         from inside tmux, in a popup
#
# Attaches when run outside tmux, switches the client when run inside it.
set -uo pipefail

RESURRECT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"

# Outside tmux there may be no server yet — after a reboot there certainly is
# not. Starting one sources tmux.conf, and that is what makes tmux-continuum
# restore the last saved state, so the sessions show up in the list below.
# It restores in the background, hence the wait; skip waiting when there is
# nothing saved to restore.
if [[ -z ${TMUX:-} ]] && ! tmux list-sessions >/dev/null 2>&1; then
	tmux start-server 2>/dev/null
	if [[ -e "$RESURRECT_DIR/last" ]]; then
		for _ in $(seq 1 24); do
			tmux list-sessions >/dev/null 2>&1 && break
			sleep 0.25
		done
	fi
fi

# Inside a tmux popup the picker owns the whole surface.
height=60%
[[ -n ${TMUX:-} ]] && height=100%

# --exact matters more than it looks: with fuzzy matching on, typing a name for
# a *new* session lands on whatever old session happens to contain those letters
# in order ("hue" matches "gitHUb-managEment"), and Enter attaches to that
# instead of creating anything. Exact mode still matches substrings, so typing
# part of an existing name to pick it keeps working.
# Alt-Enter is the escape hatch for the remaining case: creating a session whose
# name is a substring of an existing one ("web" while "arcziweb" is open).
out=$(
	sesh list -t --icons | fzf \
		--ansi \
		--exact \
		--print-query \
		--expect alt-enter \
		--accept-nth '2..' \
		--height "$height" --reverse --border --border-label ' sessions ' \
		--prompt '⚡ ' \
		--header 'enter: attach/create   alt-enter: create from typed name' \
		--preview 'sesh preview {2..}' \
		--preview-window 'right:55%,border-left' \
		--bind 'tab:down,btab:up'
)

# With both flags fzf prints three lines: the typed query, the key that accepted
# (empty for plain Enter) and the selected entry, the last of which is absent
# when nothing matched. --accept-nth drops the icon column; --ansi makes fzf
# interpret sesh's colour codes rather than printing them as text.
query='' key='' selection=''
{ IFS= read -r query; IFS= read -r key; IFS= read -r selection; } <<<"$out"

if [[ $key == alt-enter ]]; then
	name=$query
else
	name=${selection:-$query}
fi

# Nothing typed and nothing picked: leave things as they are.
[[ -n $name ]] || exit 1

# Exact match. `tmux has-session -t=NAME` is not usable here — it still matches
# prefixes, so a new session named "api" would attach to an existing
# "api-gateway" instead of being created.
if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF -- "$name"; then
	# sesh attaches or switches depending on whether we are already in tmux.
	exec sesh connect "$name"
fi

if [[ -n ${TMUX:-} ]]; then
	tmux new-session -d -s "$name"
	exec tmux switch-client -t "$name"
else
	exec tmux new-session -s "$name"
fi
